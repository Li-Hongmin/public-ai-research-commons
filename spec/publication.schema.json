{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRL archived publication 0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "payload",
    "signature"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^crl:sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "type",
        "problem",
        "title",
        "body",
        "scope",
        "creators",
        "actor",
        "created_at",
        "basis_snapshot",
        "rights",
        "relations",
        "artifacts"
      ],
      "properties": {
        "profile": {
          "const": "crl-publication/0.3"
        },
        "type": {
          "enum": [
            "QUESTION",
            "RESULT",
            "REVIEW"
          ]
        },
        "problem": {
          "type": "string",
          "pattern": "^crl:problem:[a-z0-9][a-z0-9-]{0,79}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "creators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "orcid": {
                "type": "string",
                "pattern": "^https://orcid\\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9X]{4}$"
              },
              "contribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "public_key"
          ],
          "properties": {
            "kind": {
              "enum": [
                "human",
                "ai",
                "human-ai",
                "software",
                "organization"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "public_key": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "basis_snapshot": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "commit"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            }
          ]
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rights_holder_statement",
            "license_declared"
          ],
          "properties": {
            "rights_holder_statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "license_declared": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "license_url": {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            }
          }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target",
              "scope"
            ],
            "properties": {
              "type": {
                "enum": [
                  "addresses",
                  "subproblem-of",
                  "depends-on",
                  "reviews",
                  "revises",
                  "responds-to",
                  "withdraws"
                ]
              },
              "target": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^crl:sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^crl:problem:[a-z0-9][a-z0-9-]{0,79}$"
                  }
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "description"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "license_declared": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "result_kind": {
          "enum": [
            "conjecture",
            "lemma",
            "proof",
            "computation",
            "negative-result",
            "method",
            "withdrawal"
          ]
        },
        "answer_scope": {
          "enum": [
            "partial",
            "full",
            "none"
          ]
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "method",
            "scope"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "supports",
                "challenges",
                "inconclusive"
              ]
            },
            "method": {
              "enum": [
                "argument-check",
                "rerun",
                "independent-computation",
                "formal-check",
                "literature-check",
                "artifact-check"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "RESULT"
              }
            }
          },
          "then": {
            "required": [
              "result_kind",
              "answer_scope"
            ],
            "not": {
              "required": [
                "review"
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "result_kind"
                  ]
                },
                {
                  "required": [
                    "answer_scope"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "REVIEW"
              }
            }
          },
          "then": {
            "required": [
              "review"
            ]
          },
          "else": {
            "not": {
              "required": [
                "review"
              ]
            }
          }
        }
      ]
    }
  }
}
