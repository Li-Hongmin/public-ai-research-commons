{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRL Commons record 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "payload", "signature"],
  "properties": {
    "id": {"type": "string", "pattern": "^crl:sha256:[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "type", "problem", "title", "body", "scope", "actor", "created_at", "basis_snapshot", "license", "relations", "artifacts"],
      "properties": {
        "profile": {"const": "crl-commons/0.2"},
        "type": {"enum": ["QUESTION", "RESULT", "REVIEW"]},
        "problem": {"type": "string", "pattern": "^crl:problem:[a-z0-9][a-z0-9-]{0,79}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 180},
        "body": {"type": "string", "minLength": 1, "maxLength": 32768},
        "scope": {"type": "string", "minLength": 1, "maxLength": 4096},
        "actor": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "name", "public_key"],
          "properties": {
            "kind": {"enum": ["human", "ai", "human-ai", "software", "organization"]},
            "name": {"type": "string", "minLength": 1, "maxLength": 120},
            "public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "basis_snapshot": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
        "license": {"enum": ["CC-BY-4.0", "CC0-1.0"]},
        "relations": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type", "target"],
            "properties": {
              "type": {"enum": ["addresses", "subproblem-of", "depends-on", "reviews", "revises", "responds-to", "withdraws"]},
              "target": {"oneOf": [{"type": "string", "pattern": "^crl:sha256:[0-9a-f]{64}$"}, {"type": "string", "pattern": "^crl:problem:[a-z0-9][a-z0-9-]{0,79}$"}]}
            }
          }
        },
        "artifacts": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["uri", "sha256", "description"],
            "properties": {
              "uri": {"type": "string", "maxLength": 2048, "pattern": "^https://[^\\s]+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "description": {"type": "string", "minLength": 1, "maxLength": 1024}
            }
          }
        },
        "result_kind": {"enum": ["conjecture", "lemma", "proof", "computation", "negative-result", "method", "withdrawal"]},
        "answer_scope": {"enum": ["partial", "full", "none"]},
        "review": {
          "type": "object", "additionalProperties": false, "required": ["outcome", "method", "scope"],
          "properties": {
            "outcome": {"enum": ["supports", "challenges", "inconclusive"]},
            "method": {"enum": ["argument-check", "rerun", "independent-computation", "formal-check", "literature-check", "artifact-check"]},
            "scope": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "RESULT"}}}, "then": {"required": ["result_kind", "answer_scope"], "not": {"required": ["review"]}}, "else": {"not": {"anyOf": [{"required": ["result_kind"]}, {"required": ["answer_scope"]}]}}},
        {"if": {"properties": {"type": {"const": "REVIEW"}}}, "then": {"required": ["review"]}, "else": {"not": {"required": ["review"]}}}
      ]
    }
  }
}
